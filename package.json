{
  "name": "hqchat-server",
  "version": "1.0.0",
  "description": "The server half of hqchat: HQC-KEM handshake, per-topic ACL, push bridge. It never sees a message.",
  "scripts": {
    "auth": "tsx auth/main.ts",
    "api": "tsx api/main.ts",
    "push": "tsx push/main.ts",
    "broker-watch": "tsx ops/broker-watch.ts",
    "bot": "tsx bot/bot.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:e2e": "node --import tsx --test --test-force-exit test/e2e/mqtt.test.ts",
    "migrate": "tsx services/db/migrate.ts",
    "check-mqtt-acl": "tsx scripts/check-mqtt-acl.ts",
    "check-push": "tsx scripts/check-push.ts",
    "rebuild-mqtt-acl": "tsx scripts/rebuild-mqtt-acl.ts",
    "reports": "tsx scripts/reports.ts",
    "coverage": "mkdir -p coverage && node --import tsx --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test-reporter=spec --test-reporter-destination=stdout test/*.test.ts && tsx scripts/coverage-report.ts --lcov coverage/lcov.info --min-line 90 --min-reached 91",
    "mutation": "stryker run",
    "test:load": "node --import tsx --test --test-force-exit --test-timeout=300000 test/e2e/load.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MartinRougeron2/HQChat-Server.git"
  },
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@sentry/node": "^8.55.2",
    "dotenv": "^17.2.3",
    "koffi": "^2.15.0",
    "mqtt": "^5.15.2",
    "pg": "^8.13.1",
    "stripe": "^17.5.0",
    "tsx": "^4.21.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@types/ffi-napi": "^4.0.10",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.11.10",
    "@types/ref-napi": "^3.0.12",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  }
}
